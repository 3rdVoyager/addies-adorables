---
import headerData from "../data/header.json";

const { brand, navigation } = headerData;
const currentPath = Astro.url.pathname;
---

<header>
  <a class="site-brand" href="/">
    <span class="brand-mark" aria-hidden="true">{brand.mark}</span>
    <span class="brand-name">{brand.name}</span>
  </a>

  <nav class="main-nav" aria-label="Main navigation">
    <ul>
      {
        navigation.navLinks.map((link) => (
          <li aria-current={currentPath === link.href ? "page" : undefined}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="header-actions">
    {
      navigation.ctaLinks.map((cta) => (
        <a class="header-cta" href={cta.href}>{cta.label}</a>
      ))
    }
  </div>
</header>
