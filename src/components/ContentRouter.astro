---
import { render, type CollectionEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import ContentSection from "./ContentSection.astro";
import Hero from "./Hero.astro";

const { entry } = Astro.props as {
  entry: CollectionEntry<"pages">;
};

const { Content } = await render(entry);
---

<PageLayout pageTitle={entry.data.pageTitle}>
  <Hero
    type={entry.id === "index" ? "home" : undefined}
    heroTitle={entry.data.heroTitle ?? entry.data.pageTitle}
    subTitle={entry.data.subTitle}
  />

  <ContentSection title={entry.data.pageTitle}>
    <Content />
  </ContentSection>
</PageLayout>
