---
import PageLayout from "../../layouts/PageLayout.astro";
import type { MarkdownInstance } from "astro";
import ContentSection from '../../components/ContentSection.astro';
import ContentBlock from '../../components/ContentBlock.astro';
import Hero from '../../components/Hero.astro';

const adorables = Object.values(import.meta.glob<MarkdownInstance<AdorableFrontmatter>>("./*.md", { eager: true }));

type AdorableFrontmatter = {
  pageTitle: string;
};
---

<PageLayout pageTitle="Adorables">
  <Hero heroTitle="Browse Adorables" subTitle="Browse all the adorable crafts and items Addie has made." />
  <ContentSection columns="3-columns">
    {adorables.map((adorable) => (
      <ContentBlock type="card" title={adorable.frontmatter.pageTitle}>
        <a href={adorable.url}>View details</a>
      </ContentBlock>
    ))}
  </ContentSection>
</PageLayout>